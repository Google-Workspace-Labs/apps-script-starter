{
  "name": "apps-script-starter",
  "version": "1.0.0",
  "description": "Google Apps Script monorepo starter with TypeScript and workspace-core",
  "private": true,
  "type": "module",
  "workspaces": [
    "projects/*"
  ],
  "scripts": {
    "build:all": "npm run build --workspaces",
    "watch:all": "npm run watch --workspaces",
    "push:all": "npm run push --workspaces",
    "new": "./scripts/create-project.sh"
  },
  "keywords": [
    "google-apps-script",
    "typescript",
    "template",
    "starter"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "@types/google-apps-script": "^1.0.83",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
