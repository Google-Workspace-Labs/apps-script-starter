{
  "name": "apps-script-projects",
  "version": "1.0.0",
  "description": "Personal workspace for Apps Script projects",
  "private": true,
  "author": "mone",
  "license": "MIT",
  "keywords": [
    "google-apps-script",
    "javascript",
    "monorepo",
    "clasp",
    "gas"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write 'projects/**/*.{js,html,json}'",
    "format:check": "prettier --check 'projects/**/*.{js,html,json}'",
    "lint": "eslint 'projects/**/*.js'",
    "lint:fix": "eslint --fix 'projects/**/*.js'"
  },
  "lint-staged": {
    "projects/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "projects/**/*.html": [
      "prettier --write"
    ],
    "projects/**/*.json": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@google/clasp": "^3.1.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^10.3.10",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5"
  }
}
