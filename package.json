{
  "name": "apps-script-starter",
  "version": "1.0.0",
  "description": "Google Apps Script starter template with TypeScript and workspace-core",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "push": "npm run build && clasp push",
    "pull": "clasp pull",
    "open": "clasp open",
    "deploy": "npm run build && clasp push && clasp deploy",
    "logs": "clasp logs"
  },
  "keywords": [
    "google-apps-script",
    "typescript",
    "template",
    "starter"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "@types/google-apps-script": "^1.0.83",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
